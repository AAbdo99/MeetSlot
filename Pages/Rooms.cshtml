@page "/rooms"
@model MeetSlot.Pages.RoomsModel

<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MeetSlot – Møterom</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'DM Sans', sans-serif;
            background: #f4f4f2;
            min-height: 100vh;
        }

        nav {
            background: #0f1923;
            padding: 0 2rem;
            height: 56px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .logo { color: #fff; font-weight: 600; font-size: 18px; letter-spacing: -0.5px; }
        .logo span { color: #1D9E75; }

        .nav-badge {
            background: rgba(29,158,117,0.15);
            border: 1px solid rgba(29,158,117,0.3);
            color: #5DCAA5;
            font-size: 12px;
            font-family: 'DM Mono', monospace;
            padding: 4px 10px;
            border-radius: 20px;
        }

        .hero {
            background: #0f1923;
            padding: 3rem 2rem 4rem;
            color: white;
        }

        .hero-tag {
            font-family: 'DM Mono', monospace;
            font-size: 11px;
            color: #5DCAA5;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 12px;
        }

        .hero h1 {
            font-size: 32px;
            font-weight: 300;
            letter-spacing: -1px;
            margin-bottom: 8px;
            color: #fff;
        }

        .hero h1 strong { font-weight: 600; color: #1D9E75; }

        .hero p { color: rgba(255,255,255,0.45); font-size: 14px; }

        .stats { display: flex; gap: 2rem; margin-top: 2rem; }

        .stat-val {
            font-size: 28px;
            font-weight: 300;
            color: #fff;
            line-height: 1;
        }

        .stat-label {
            font-size: 11px;
            color: rgba(255,255,255,0.35);
            margin-top: 4px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .content {
            padding: 2rem;
            max-width: 900px;
            margin: 0 auto;
        }

        .filter-row {
            display: flex;
            gap: 8px;
            margin-bottom: 1.5rem;
            align-items: center;
        }

        .filter-label {
            font-size: 12px;
            color: #888;
            margin-right: 4px;
        }

        .pill {
            border: 0.5px solid #ddd;
            background: #fff;
            border-radius: 20px;
            padding: 5px 14px;
            font-size: 12px;
            color: #666;
            cursor: pointer;
            transition: all 0.2s ease;
            font-family: 'DM Sans', sans-serif;
        }

        .pill.active {
            background: #0f1923;
            color: #5DCAA5;
            border-color: #0f1923;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 12px;
        }

        .card {
            background: #fff;
            border: 0.5px solid #ddd;
            border-radius: 12px;
            overflow: hidden;
        }

        .card-top {
            background: #0f1923;
            padding: 1.25rem 1.25rem 1rem;
            position: relative;
        }

        .card-num {
            font-family: 'DM Mono', monospace;
            font-size: 11px;
            color: rgba(255,255,255,0.25);
            margin-bottom: 8px;
        }

        .card-name {
            font-size: 17px;
            font-weight: 500;
            color: #fff;
            letter-spacing: -0.3px;
        }

        .card-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #1D9E75;
            position: absolute;
            top: 1.25rem;
            right: 1.25rem;
            box-shadow: 0 0 0 3px rgba(29,158,117,0.2);
        }

        .card-body { padding: 1rem 1.25rem; }

        .card-desc {
            font-size: 13px;
            color: #666;
            margin-bottom: 12px;
            line-height: 1.5;
        }

        .card-meta { display: flex; align-items: center; gap: 8px; }

        .cap-badge {
            background: #f4f4f2;
            border: 0.5px solid #ddd;
            border-radius: 6px;
            padding: 4px 10px;
            font-size: 12px;
            font-family: 'DM Mono', monospace;
            color: #666;
        }

        .book-btn {
            margin-left: auto;
            background: #0f1923;
            border: 1px solid #0f1923;
            border-radius: 6px;
            padding: 6px 12px;
            font-size: 12px;
            font-family: 'DM Mono', monospace;
            color: #5DCAA5;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .book-btn:hover {
            background: #152332;
            border-color: #152332;
        }

        .empty {
            text-align: center;
            padding: 4rem 2rem;
            color: #888;
            font-size: 15px;
        }
    </style>
</head>
<body>

    <nav>
        <div class="logo">Meet<span>Slot</span></div>
        <div class="nav-badge">LIVE</div>
    </nav>

    <div class="hero">
        <div class="hero-tag">Tilgjengelige rom</div>
        <h1>Finn ditt <strong>møterom</strong></h1>
        <p>Velg et rom og book ønsket tidspunkt</p>
        <div class="stats">
            <div>
                <div class="stat-val">@Model.Rooms.Count</div>
                <div class="stat-label">Rom tilgjengelig</div>
            </div>
            <div>
                <div class="stat-val">@Model.Rooms.Sum(r => r.Capacity)</div>
                <div class="stat-label">Plasser totalt</div>
            </div>
        </div>
    </div>

    <div class="content">
        @if (!Model.Rooms.Any())
        {
            <div class="empty">
                Ingen møterom funnet i databasen.
            </div>
        }
        else
        {
            <div class="filter-row">
                <span class="filter-label">Vis:</span>
                <div class="pill active" onclick="filterRooms('alle', this)">Alle</div>
                <div class="pill" onclick="filterRooms('liten', this)">Liten (1-4)</div>
                <div class="pill" onclick="filterRooms('medium', this)">Medium (5-8)</div>
                <div class="pill" onclick="filterRooms('stor', this)">Stor (9+)</div>
            </div>

            <div class="grid">
                @for (int i = 0; i < Model.Rooms.Count; i++)
                {
                    var room = Model.Rooms[i];
                    <div class="card" data-capacity="@room.Capacity">
                        <div class="card-top">
                            <div class="card-num">ROM-0@(i + 1)</div>
                            <div class="card-name">@room.Name</div>
                            <div class="card-dot"></div>
                        </div>
                        <div class="card-body">
                            <p class="card-desc">
                                @(string.IsNullOrWhiteSpace(room.Description) ? "Ingen beskrivelse." : room.Description)
                            </p>
                            <div class="card-meta">
                                <span class="cap-badge">@room.Capacity plasser</span>
                                <a class="book-btn" href="/comingsoon">Book</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <script>
        // Filtrerer romkort i UI basert på data-capacity.
        function filterRooms(filter, clickedPill) {
            document.querySelectorAll('.pill').forEach(p => p.classList.remove('active'));
            clickedPill.classList.add('active');

            document.querySelectorAll('.card').forEach(card => {
                const cap = parseInt(card.dataset.capacity);
                let vis = false;

                if (filter === 'alle') vis = true;
                else if (filter === 'liten') vis = cap <= 4;
                else if (filter === 'medium') vis = cap >= 5 && cap <= 8;
                else if (filter === 'stor') vis = cap >= 9;

                card.style.display = vis ? 'block' : 'none';
            });
        }
    </script>

</body>
</html>